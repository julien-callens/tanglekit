{
  "name": "tanglekit",
  "version": "0.6.6",
  "description": "A compiler for tngl files using ANTLR4",
  "main": "src/js/main.js",
  "type": "module",
  "scripts": {
    "build": "cd src/g4 && java -jar ../../antlr/antlr-4.13.2-complete.jar -Dlanguage=JavaScript -visitor -Xexact-output-dir -o ../js/generated TangleLexer.g4 TangleParser.g4",
    "test": "vitest --run",
    "pack": "npm pack"
  },
  "dependencies": {
    "antlr4": "^4.13.2",
    "html-tags": "^4.0.0",
    "prettier": "^3.5.1"
  },
  "keywords": [],
  "author": "Julien Callens",
  "license": "ISC",
  "files": [
    "src/js/classes/",
    "src/js/functions/",
    "src/js/generated/*.js",
    "src/js/main.js",
    "src/vite/",
    "README.md"
  ],
  "devDependencies": {
    "vitest": "^2.1.8",
    "jsdom": "^26.1.0",
    "vite": "^5.4.11"
  }
}
